---
---

<section id="sobre-mi" class="relative z-[2] bg-[#FAF7F2] py-24">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8">
    
    <div class="stitch-divider" aria-hidden="true"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      
      <!-- Imagen de Perfil (Izquierda en desktop 40%, arriba en mobile) -->
      <div class="lg:col-span-5 w-full">
        <div class="w-full h-[320px] lg:h-[420px] rounded-2xl overflow-hidden border border-[#E0D8CE]">
          <img
            src={`${import.meta.env.BASE_URL}images/perfil.webp`}
            alt="Milagro en su taller de costura en Alto Comedero"
            width="800"
            height="800"
            loading="lazy"
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>

      <!-- Texto (Derecha en desktop 60%, abajo en mobile) -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <h2 class="text-[#2C2A28] mb-6 text-left">
          Sobre Milagro
        </h2>
        
        <p class="text-[#2C2A28] text-body mb-4">
          Soy Milagro, costurera de Alto Comedero. Hace años que me dedico a arreglar, ajustar y confeccionar prendas.
        </p>
        
        <p class="text-[#6B6560] text-body">
          Mi taller es un espacio limpio y ordenado, donde cada prenda recibe la atención que merece.
        </p>
      </div>

    </div>

  </div>
</section>
