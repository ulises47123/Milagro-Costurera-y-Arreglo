---
import { SITE_CONFIG, getWhatsAppUrl } from '../config';

import Logo from './Logo.astro';

const navLinks = [
  { href: "#servicios", label: "Servicios" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#galeria", label: "Galería" },
  { href: "#contacto", label: "Contacto" },
];

const whatsappUrl = getWhatsAppUrl();
---

<header class="sticky top-0 z-[100] w-full bg-[#FAF7F2]/90 backdrop-blur-md border-b border-[#E0D8CE]/50 transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8 h-16 md:h-[72px] flex items-center justify-between">
    <!-- Logotipo Oficial SVG -->
    <Logo variant="light" class="py-1" />

    <!-- Navegación Desktop -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[#6B6560] hover:text-[#B8735A] font-medium transition-colors text-[1rem]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Botón Hamburguesa Mobile -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex items-center justify-center w-6 h-6 text-[#2C2A28] focus-visible:outline-2 focus-visible:outline-[#B8735A]"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Mobile -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-[#FAF7F2] border-b border-[#E0D8CE] px-4 py-6 shadow-md transition-all"
    aria-label="Menú móvil"
  >
    <nav class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-[#2C2A28] hover:text-[#B8735A] text-lg font-medium py-2 border-b border-[#E0D8CE]/40 last:border-0"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- Botón Flotante de WhatsApp -->
<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener"
  aria-label="Escribime por WhatsApp"
  class="fixed bottom-6 right-6 z-[200] flex items-center justify-center w-14 h-14 rounded-full bg-[#B8735A] hover:bg-[#9A5E48] text-white shadow-lg transition-all transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2C2A28]"
>
  <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.771.815 2.795.815 3.182 0 5.768-2.587 5.768-5.766.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.145.407-.841.774-1.163.824-.321.05-.737.073-2.385-.609-1.986-.82-3.238-2.825-3.336-2.957-.099-.133-.801-1.066-.801-2.034 0-.968.508-1.444.689-1.642.181-.198.396-.248.528-.248.132 0 .264.002.379.008.122.006.284-.046.444.339.165.397.561 1.371.611 1.47.05.099.083.215.017.347-.066.132-.099.215-.198.33-.099.116-.208.259-.297.348-.099.099-.202.207-.087.405.115.198.513.847 1.1 1.37.756.673 1.393.882 1.591.981.198.099.314.083.43-.05.116-.132.496-.578.628-.776.132-.198.264-.165.446-.099.182.066 1.156.545 1.354.644.198.099.33.149.379.231.05.083.05.479-.095.886zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.435 5.178L2 22l4.981-1.306A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
  </svg>
</a>

<script>
  // Menú Hamburguesa Mobile
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
