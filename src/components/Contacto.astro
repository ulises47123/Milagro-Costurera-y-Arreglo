---
import { SITE_CONFIG, getWhatsAppUrl, getTikTokUrl, getInstagramUrl } from '../config';

const whatsappUrl = getWhatsAppUrl();
const tiktokUrl = getTikTokUrl();
const instagramUrl = getInstagramUrl();
---

<section id="contacto" class="relative z-[2] bg-[#FAF7F2] py-24">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8 text-center flex flex-col items-center">
    
    <div class="stitch-divider" aria-hidden="true"></div>

    <h2 class="text-[#2C2A28] mb-16">
      Escribime
    </h2>

    <!-- Botón grande de WhatsApp -->
    <div class="mb-8">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        aria-label="Escribime por WhatsApp"
        class="inline-flex items-center justify-center gap-3 px-9 py-[18px] rounded-lg bg-[#B8735A] hover:bg-[#9A5E48] text-white font-semibold text-[1.125rem] transition-colors shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2C2A28]"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.771.815 2.795.815 3.182 0 5.768-2.587 5.768-5.766.001-3.18-2.585-5.766-5.767-5.766zm3.376 8.21c-.145.407-.841.774-1.163.824-.321.05-.737.073-2.385-.609-1.986-.82-3.238-2.825-3.336-2.957-.099-.133-.801-1.066-.801-2.034 0-.968.508-1.444.689-1.642.181-.198.396-.248.528-.248.132 0 .264.002.379.008.122.006.284-.046.444.339.165.397.561 1.371.611 1.47.05.099.083.215.017.347-.066.132-.099.215-.198.33-.099.116-.208.259-.297.348-.099.099-.202.207-.087.405.115.198.513.847 1.1 1.37.756.673 1.393.882 1.591.981.198.099.314.083.43-.05.116-.132.496-.578.628-.776.132-.198.264-.165.446-.099.182.066 1.156.545 1.354.644.198.099.33.149.379.231.05.083.05.479-.095.886zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.435 5.178L2 22l4.981-1.306A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        Escribime por WhatsApp
      </a>
    </div>

    <!-- Redes Sociales: Instagram y TikTok -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mb-8">
      <!-- Enlace a Instagram -->
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-[#B8735A] hover:underline font-medium text-[1rem] transition-all focus-visible:outline-2 focus-visible:outline-[#B8735A]"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Seguime en Instagram: @{SITE_CONFIG.instagram}
      </a>

      <!-- Enlace a TikTok -->
      <a
        href={tiktokUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-[#B8735A] hover:underline font-medium text-[1rem] transition-all focus-visible:outline-2 focus-visible:outline-[#B8735A]"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.85.12V9.38a6.37 6.37 0 0 0-.85-.06A6.34 6.34 0 0 0 3.1 15.66a6.34 6.34 0 0 0 10.82 4.48 6.27 6.27 0 0 0 1.87-4.47V8.65a8.28 8.28 0 0 0 4.79 1.5V6.7c-.33 0-.66-.01-.99-.01z"/>
        </svg>
        Seguime en TikTok: @{SITE_CONFIG.tiktok}
      </a>
    </div>

    <!-- Texto de apoyo -->
    <p class="text-[#6B6560] text-small">
      Respondo dentro de las 24 horas.
    </p>

  </div>
</section>
