---
---

<section class="relative z-[2] bg-[#E8E0D5] py-24">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8">
    
    <div class="stitch-divider" aria-hidden="true"></div>

    <h2 class="text-center text-[#2C2A28] mb-16">
      Cómo trabajo
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Bloque 1: Ubicación -->
      <div class="bg-[#FAF7F2] rounded-xl p-8 border border-[#E0D8CE] flex flex-col items-start shadow-xs">
        <div class="text-[#B8735A] mb-6">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-[#2C2A28] mb-3">
          Taller en Barrio El Chingo
        </h3>
        <p class="text-[#6B6560] text-body">
          San Salvador de Jujuy, Argentina. Atención presencial.
        </p>
      </div>

      <!-- Bloque 2: Horarios -->
      <div class="bg-[#FAF7F2] rounded-xl p-8 border border-[#E0D8CE] flex flex-col items-start shadow-xs">
        <div class="text-[#B8735A] mb-6">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-[#2C2A28] mb-3">
          Horarios
        </h3>
        <ul class="text-[#6B6560] text-body space-y-1">
          <li><strong>Lunes a viernes:</strong> 8:00 a 18:00</li>
          <li class="text-small text-[#6B6560]/80 pl-2">Mañana: 8:00 a 12:00 | Tarde: 14:00 a 18:00 (Corte 12 a 14)</li>
          <li><strong>Sábados:</strong> 13:00 a 16:00</li>
          <li><strong>Domingos:</strong> cerrado</li>
        </ul>
      </div>

      <!-- Bloque 3: Modalidad -->
      <div class="bg-[#FAF7F2] rounded-xl p-8 border border-[#E0D8CE] flex flex-col items-start shadow-xs">
        <div class="text-[#B8735A] mb-6">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <h3 class="text-[#2C2A28] mb-3">
          Cómo trabajamos
        </h3>
        <p class="text-[#6B6560] text-body">
          Dejás tu prenda o encargo y lo retirás listo. Te aviso por WhatsApp cuando esté terminado.
        </p>
      </div>

    </div>

  </div>
</section>
