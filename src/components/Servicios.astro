---
const services = [
  {
    icon: "scissors",
    title: "Arreglos rápidos",
    items: [
      "Cambio de botones",
      "Cambio de cierres",
      "Bastillas y ruedos",
      "Arreglos de forros"
    ],
    description: "Dejás la prenda y la retirás lista en pocos días."
  },
  {
    icon: "dress",
    title: "Ajustes y reformas",
    items: [
      "Ajustes de vestidos",
      "Arreglo de jeans",
      "Entalle y reformas de prendas"
    ],
    description: "Le damos nueva vida a esa prenda que ya no te queda."
  },
  {
    icon: "curtain",
    title: "Costura de hogar",
    items: [
      "Mantelería",
      "Servilletas de tela",
      "Cortinas a medida",
      "Fundas y almohadones"
    ],
    description: "Detalles prolijos y a medida para vestir los espacios de tu hogar."
  },
  {
    icon: "yarn",
    title: "Tejidos artesanales",
    items: [
      "Prendas y accesorios tejidos",
      "Crochet y dos agujas",
      "Arreglos y adaptaciones de tejidos"
    ],
    description: "Piezas artesanales tejidas con paciencia, prolijidad y cariño."
  }
];
---

<section id="servicios" class="relative z-[2] bg-[#F0EBE3] py-24">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8">
    
    <div class="stitch-divider" aria-hidden="true"></div>

    <h2 class="text-center text-[#2C2A28] mb-16">
      ¿Qué hago?
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <div class="bg-[#FAF7F2] rounded-xl p-6 sm:p-7 border border-[#E0D8CE] flex flex-col justify-between shadow-xs">
          <div>
            <!-- Iconos Vectoriales Temáticos en #B8735A stroke 1.5 -->
            <div class="text-[#B8735A] mb-5 inline-block">
              {service.icon === 'scissors' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0L12 12zm0 0L9.121 9.121a3 3 0 10-4.242 4.242 3 3 0 004.242 0L12 12z" />
                </svg>
              )}
              {service.icon === 'dress' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v2m-3-2c0 2 1.5 3 3 3s3-1 3-3M9 6l-3 4 2 2-1 9h10l-1-9 2-2-3-4H9z" />
                </svg>
              )}
              {service.icon === 'curtain' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M4 4v16a1 1 0 001 1h4a1 1 0 001-1V4M14 4v16a1 1 0 001 1h4a1 1 0 001-1V4M7 8h.01M17 8h.01M7 12h.01M17 12h.01" />
                </svg>
              )}
              {service.icon === 'yarn' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a9 9 0 100 18 9 9 0 000-18zm-4.5 4.5c3 3 6 3 9 0M6 12c4 2 8 2 12 0m-10.5 4.5c3-3 6-3 9 0M18 6l3-3m-15 15l-3 3" />
                </svg>
              )}
            </div>

            <h3 class="text-[#2C2A28] mb-4 text-[1.25rem]">
              {service.title}
            </h3>

            <ul class="space-y-2 mb-6">
              {service.items.map((item) => (
                <li class="flex items-start text-[#2C2A28] text-[0.95rem] leading-relaxed gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#B8735A] mt-2 flex-shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="text-[#6B6560] text-small border-t border-[#E0D8CE] pt-4 mt-auto">
            {service.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
