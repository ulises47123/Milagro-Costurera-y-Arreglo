---
const services = [
  {
    icon: "scissors",
    title: "Arreglos rápidos",
    items: [
      "Cambio de botones",
      "Cambio de cierres",
      "Bastillas",
      "Arreglos de forros"
    ],
    description: "Dejás la prenda y la retirás en pocos días."
  },
  {
    icon: "dress",
    title: "Ajustes y reformas",
    items: [
      "Ajustes de vestidos",
      "Arreglo de jeans",
      "Reformas de prendas"
    ],
    description: "Le damos nueva vida a esa prenda que ya no te queda."
  },
  {
    icon: "sewing-machine",
    title: "Confección a medida",
    items: [
      "Prendas desde cero",
      "Diseños personalizados"
    ],
    description: "Contame qué tenés en mente y lo hacemos realidad."
  }
];
---

<section id="servicios" class="relative z-[2] bg-[#F0EBE3] py-24">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8">
    
    <div class="stitch-divider" aria-hidden="true"></div>

    <h2 class="text-center text-[#2C2A28] mb-16">
      ¿Qué hago?
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class="bg-[#FAF7F2] rounded-xl p-8 border border-[#E0D8CE] flex flex-col justify-between">
          <div>
            <!-- Icono SVG 32x32 stroke-width 1.5 -->
            <div class="text-[#B8735A] mb-6 inline-block">
              {service.icon === 'scissors' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0L12 12zm0 0L9.121 9.121a3 3 0 10-4.242 4.242 3 3 0 004.242 0L12 12z" />
                </svg>
              )}
              {service.icon === 'dress' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v2m-3-2c0 2 1.5 3 3 3s3-1 3-3M9 6l-3 4 2 2-1 9h10l-1-9 2-2-3-4H9z" />
                </svg>
              )}
              {service.icon === 'sewing-machine' && (
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 19h18M5 19V8a2 2 0 012-2h10a2 2 0 012 2v11M9 10h6m-6 3h2m-2 3h.01M17 11a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" />
                </svg>
              )}
            </div>

            <h3 class="text-[#2C2A28] mb-4">
              {service.title}
            </h3>

            <ul class="space-y-2 mb-6">
              {service.items.map((item) => (
                <li class="flex items-center text-[#2C2A28] text-body gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#B8735A] flex-shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="text-[#6B6560] text-body border-t border-[#E0D8CE] pt-4 mt-auto">
            {service.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
