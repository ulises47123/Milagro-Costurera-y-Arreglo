---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { variant = 'light', class: className = '', size = 'md' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const sizeClasses = {
  sm: 'h-16 md:h-20',
  md: 'h-20 sm:h-24 md:h-28 max-w-[260px] sm:max-w-[320px]',
  lg: 'h-28 sm:h-36 md:h-40 max-w-[340px] sm:max-w-[420px]',
  xl: 'h-36 sm:h-44 md:h-52 max-w-[420px] sm:max-w-[500px]'
};
---

<a href="#" class={`inline-flex items-center group shrink-0 ${className}`} aria-label="Milagro - Costura y Arreglos - Inicio">
  <img
    src={`${baseUrl}images/logo.svg`}
    alt="Milagro — Costura y Arreglos"
    class={`${sizeClasses[size]} w-auto object-contain transition-transform duration-200 group-hover:scale-105 ${variant === 'dark' ? 'brightness-0 invert opacity-95' : ''}`}
  />
</a>
